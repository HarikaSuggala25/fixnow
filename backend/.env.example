# =====================================================================
# FixNow - MongoDB Configuration Environment
# =====================================================================
# To use MongoDB Atlas (Free Cloud Database):
# 1. Create a free cluster on https://cloud.mongodb.com
# 2. Click "Connect" -> "Drivers" -> Copy your connection string
# 3. Paste it below and replace <password> with your database user password:
#
# MONGODB_URI=mongodb+srv://fixnow_admin:<password>@cluster0.abcde.mongodb.net/fixnow_db?retryWrites=true&w=majority
#
# To use Local MongoDB on your machine (default port 27017):
MONGODB_URI=mongodb://127.0.0.1:27017/fixnow_db
DB_NAME=fixnow_db
PORT=8000
